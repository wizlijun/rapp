# systemd unit for rapp-relay on the VPS (example).
#
#   install -m 755 rapp-relay-x86_64-linux /usr/local/bin/rapp-relay
#   echo 'RAPP_RELAY_KEY=<your relay key>' > /etc/rapp-relay.env && chmod 600 /etc/rapp-relay.env
#   cp rapp-relay.service /etc/systemd/system/ && systemctl enable --now rapp-relay
#   ufw allow 21116/udp      # the only port rapp needs open
[Unit]
Description=rapp relay
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/rapp-relay.env
ExecStart=/usr/local/bin/rapp-relay --key ${RAPP_RELAY_KEY} --listen 0.0.0.0:21116 --db /var/lib/rapp-relay/relay.json
DynamicUser=yes
StateDirectory=rapp-relay
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
