#!/bin/bash
# Runs as root after rapp.app lands in /Applications. Sets up the LaunchAgent
# for the console user (same plist the GUI's 启动 writes, §4), starts it,
# then opens the GUI. Nothing to do when nobody is logged in.
set -u
APP=/Applications/rapp.app
LABEL=com.rapp.service
USER_NAME=$(stat -f %Su /dev/console)
if [ -z "$USER_NAME" ] || [ "$USER_NAME" = root ] || [ "$USER_NAME" = loginwindow ]; then
    exit 0
fi
USER_ID=$(id -u "$USER_NAME")
USER_HOME=$(dscl . -read "/Users/$USER_NAME" NFSHomeDirectory | awk '{print $2}')
PLIST=$USER_HOME/Library/LaunchAgents/$LABEL.plist
# launchd opens this before the service starts, so the folder must exist (observability spec §3).
LOGS=$USER_HOME/Library/Logs/rapp

sudo -u "$USER_NAME" mkdir -p "$USER_HOME/Library/LaunchAgents"
sudo -u "$USER_NAME" mkdir -p -m 700 "$LOGS"
sudo -u "$USER_NAME" tee "$PLIST" >/dev/null <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$LABEL</string>
	<key>ProgramArguments</key>
	<array>
		<string>$APP/Contents/MacOS/rapp-service</string>
	</array>
	<key>StandardOutPath</key>
	<string>$LOGS/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>$LOGS/launchd.log</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
</dict>
</plist>
PLIST

# The pkg installs as root; the user must own the app so the service can replace it later.
[ -n "$USER_NAME" ] && chown -R "$USER_NAME":staff "$APP"

# Reinstall: stop the old agent first so the new binary is what runs.
# bootout returns before the old service has exited; bootstrapping then fails with
# "Bootstrap failed: 5: Input/output error". Wait for it to leave (≤10 s), then retry.
launchctl bootout "gui/$USER_ID/$LABEL" 2>/dev/null || true
n=0
while launchctl print "gui/$USER_ID/$LABEL" >/dev/null 2>&1 && [ $n -lt 20 ]; do sleep 0.5; n=$((n + 1)); done
for _ in 1 2 3 4 5; do launchctl bootstrap "gui/$USER_ID" "$PLIST" && break; sleep 1; done
launchctl asuser "$USER_ID" sudo -u "$USER_NAME" open "$APP"
exit 0
